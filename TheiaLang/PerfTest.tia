struct Entity
{
    Transform transform;
    float health;
    float speed;
    bool canFly;

    bool IsAlive()
    {
        return health > 0;
    }
}

struct Transform
{
    Vector3 position;
    Vector3 rotation;
    Vector3 scale;
}

struct Vector3
{
    f32 x;
    f32 y;
    f32 z;
}

float AliveBoost(Entity entity) {
    f16 x = f16(entity.transform.position.x);
    f32 h = entity.health;
    bool b = entity.IsAlive();
    if (h > 0)
    {
        x = x * 2;
    }
    return f32(x);
}

float Sum([]f32 a, int n) {
    float s = 0;
    for (int i = 0; i < n; i+=1)    //i++
    {
        s += a[i];
    }
    return s;
}

float main()
{
    @void Ptr;
    [][]f32 dynamicArrayOfDynamicArrays;
    @[]f32 ptrToDynamicArray;

    return AliveBoost(Entity{
        Transform{
            Vector3{1, 1, 1},
            Vector3{1, 1, 1},
            Vector3{1, 1, 1}},
        70,
        1.5,
        false});
}

struct DynamicArrayTest_f32
{
    s64 Length;
    @f32 Data;
    s64 Size;

    f32 __index(s64 index)
    {
        return $@f32(@void(Data));
    }
}

struct __better_dynamic_array_f32
{
    s64 Length;
    @[]f32 Data;
    s64 Size;

    f32 __index(s64 index)
    {
        return ($Data)[index];
    }
}