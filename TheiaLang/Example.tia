int Branchy(int value)
{
    if(value == 0)
    {
        value = 42;
        float f = 0;
        f = -1;
    }
    else
    {
        value = -42;
        float f = 78;
    }
    return value;
}

int Abs(int value)
{
    if(value < 0)
    {
        return -value;
    }
    return value;
}

