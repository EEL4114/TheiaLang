struct Vector3(float x, float y, float z);

union StringData(int i, float f);

int main()
{
    float[4] Vec4;
    Vec4[1] = 3;
    f32 z = Vec4[2];
    
    Entity entity = new Entity(70, 1.5);

    float HP = entity.health;
    @float healthPtr = @HP; 
    healthPtr = 5;
    
    float moreHealth = 1 + entity.health;
    @healthPtr = @moreHealth;
    HP = healthPtr;

    moreHealth += 1;

    return 0;
}

struct Entity(float health, float speed);
