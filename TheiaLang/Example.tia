int Branchy(int value)
{
    if(value == 0)
    {
        value = 42;
        float f = 0;
        f = -1;
    }
    else
    {
        value = -42;
        float f = 78;
    }
    return value;
}

int Abs(int value)
{
    if(value < 0)
    {
        return -value;
    }
    return value;
}

int Loopy(int value)
{
    for(int i = 0; i < value; i -= 3)
    {
        value += i;
    }
    return value;
}

bool n(bool b)
{
    return b;
}

