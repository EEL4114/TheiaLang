bool A(bool a, bool b)
{
    return a && b;
}

bool B(bool a, bool b)
{
    return a || b;
}

bool C(bool a, bool b, bool c)
{
    return a && (b || c);
}

bool D(bool a, bool b, bool c, bool d)
{
    return (a && b) || (c && d);
}

bool E(bool a)
{
    return a && SideEffect();
}

bool F(bool a)
{
    return a || SideEffect();
}

bool SideEffect()
{
    counter += 1;
    return true;
}

int counter;    // auto zero init