}

@void AllocB(s64 size)
{
    return __th_allocB(size);
}

@void ReallocB(@void ptr, s64 newSize)
{
    return __th_reallocB(ptr, newSize);
}


void Free(@void ptr)
{
    __th_free(ptr);
    return;
}

void TypeSize()
{
    return;
